# ===========================================
# Kolla här! – Miljövariabler
# ===========================================
# Kopiera till .env.local och fyll i dina värden.
# Använd aldrig .env.local i git – den finns i .gitignore.

# Supabase (obligatoriskt)
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role (för t.ex. delete-account, krävs endast på server)
# Använd INTE i klientkod – endast server-side.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ===========================================
# Dev: .env.local
# Preview: Vercel → Settings → Environment Variables (Preview)
# Production: Vercel → Settings → Environment Variables (Production)
# ===========================================
# Se docs/ENVIRONMENTS.md för fullständig guide.
