# ===========================================
# Kolla här! – Miljövariabler
# ===========================================
# Kopiera till .env.local och fyll i dina värden.
# Använd aldrig .env.local i git – den finns i .gitignore.

# Supabase (obligatoriskt)
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role (för delete-account, dealer-dashboard leads/views, lead-notiser)
# Använd INTE i klientkod – endast server-side. Krävs för Dealer Command Center.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Resend (för lead-e-post till dealers, admin-notiser vid import-fel)
RESEND_API_KEY=re_xxx
# Valfritt: från-adress (måste vara verifierad domän i Resend). Default: Kolla här! <hej@kollahar.se>
# RESEND_FROM_EMAIL=Kolla här! <hej@kollahar.se>

# ===========================================
# Dev: .env.local
# Preview: Vercel → Settings → Environment Variables (Preview)
# Production: Vercel → Settings → Environment Variables (Production)
# ===========================================
# Se docs/ENVIRONMENTS.md för fullständig guide.
